{
  "name": "coachlander",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:build": "expo run:android",
    "ios": "expo run:ios",
    "ios:build": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check:sql": "node scripts/check-sql.mjs",
    "check": "npm run typecheck && npm run check:sql",
    "db:pull": "node scripts/pull-db.mjs",
    "db:shell": "adb shell run-as com.coachlander.tempo sqlite3 files/SQLite/tempo.db"
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo-google-fonts/space-mono": "^0.4.2",
    "expo": "~56.0.19",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.23",
    "expo-dev-client": "~56.0.24",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-keep-awake": "~56.0.3",
    "expo-linking": "~56.0.16",
    "expo-router": "~56.2.18",
    "expo-splash-screen": "~56.0.14",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "typescript": "~6.0.3"
  },
  "private": true
}
